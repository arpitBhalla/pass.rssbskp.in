# Postgres connection. The database is created automatically if it doesn't exist.
DATABASE_URL=postgres://localhost:5432/passes
# Production (DigitalOcean; the server is checked against the CA in src/server/db/doCa.ts):
# DATABASE_URL=postgresql://rssb_passes:<password>@<host>:25060/passes?sslmode=require
# Where automatic pg_dump backups go (default: ./backups)
# BACKUP_DIR=./backups
