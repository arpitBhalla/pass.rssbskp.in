# Postgres connection. The database is created automatically if it doesn't exist.
DATABASE_URL=postgres://localhost:5432/passes
# Production (DigitalOcean), with the server's certificate checked:
# DATABASE_URL=postgresql://rssb_passes:<password>@<host>:25060/passes?sslmode=verify-full&sslrootcert=certs/do-ca.crt
# Where automatic pg_dump backups go (default: ./backups)
# BACKUP_DIR=./backups
